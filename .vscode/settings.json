{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/uefi",
    "--header-insertion=never",
    "--background-index"
  ],
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.formatting": "disabled",
  "editor.formatOnSave": true,
  "[cpp]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },
  "[c]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },
  "files.associations": { "*.asm": "asm-intel-x86-generic", "*.inc": "asm-intel-x86-generic" },
  "files.exclude": { "build/": true, ".cache/": true }
}
