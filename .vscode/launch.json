{
  // Attaches gdb to QEMU's gdb stub. tools/gdb/scroller.py loads scroller.elf's symbols at the
  // image base that efi_main logs, then releases the wait-for-debugger loop. Finalized in milestone M0.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug in QEMU",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/uefi/scroller.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "miDebuggerServerAddress": "localhost:1234",
      "stopAtConnect": false,
      "preLaunchTask": "QEMU (debug)",
      "postDebugTask": "stop QEMU",
      "setupCommands": [
        { "text": "set disassembly-flavor intel" },
        { "text": "source ${workspaceFolder}/tools/gdb/scroller.py" }
      ]
    }
  ]
}
