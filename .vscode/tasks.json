{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "cmake --preset uefi && cmake --build --preset uefi",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "test (host)",
      "type": "shell",
      "command": "cmake --preset host && cmake --build --preset host && ctest --preset host --output-on-failure",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "QEMU",
      "type": "shell",
      "command": "scripts/run-qemu.sh",
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      "label": "QEMU (debug)",
      "type": "shell",
      "command": "scripts/run-qemu.sh --debug",
      "dependsOn": "build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "qemu",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": { "beginsPattern": "^qemu: starting", "endsPattern": "^qemu: (waiting for gdb|game did not reach)" }
      }
    },
    {
      "label": "stop QEMU",
      "type": "shell",
      "command": "pkill -f 'qemu-system-x86_6[4].*-name scroller' || true",
      "problemMatcher": []
    },
    {
      "label": "GDB bridge (debug link)",
      "type": "shell",
      "command": "python3 tools/devlink.py --target ${input:devlinkTarget} gdb",
      "isBackground": true,
      "problemMatcher": {
        "owner": "devlink",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": { "beginsPattern": "^gdb bridge: target", "endsPattern": "^gdb bridge: listening" }
      }
    },
    {
      "label": "stop GDB bridge",
      "type": "shell",
      "command": "pkill -f 'tools/devlink.py .*g[d]b' || true",
      "problemMatcher": []
    },
    {
      "label": "smoke test",
      "type": "shell",
      "command": "scripts/smoke-test.sh",
      "dependsOn": "build",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "devlinkTarget",
      "type": "promptString",
      "description": "Address of the machine running the game (F1: NET line; 127.0.0.1 for QEMU)",
      "default": "127.0.0.1"
    }
  ]
}
